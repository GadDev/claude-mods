{
  "name": "@gaddev/claude-mods",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "mods/*"
  ],
  "scripts": {
    "types:fetch": "node scripts/fetch-mod-types.ts",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json && node node_modules/typescript/bin/tsc -p tsconfig.tools.json",
    "test": "node --test tests/*.test.ts",
    "validate": "node scripts/validate.ts",
    "check:native": "node scripts/check-native.ts",
    "check": "npm run lint && npm run format:check && npm run validate && npm run typecheck && npm test && npm run check:native",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "husky",
    "check:staged": "lint-staged",
    "symbols:index": "node scripts/index-symbols.ts",
    "symbols:demo": "node scripts/demo-symbols.ts"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "2.1.308",
    "@types/node": "26.6.5",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "7.0.2",
    "typescript-compiler-api": "npm:typescript@6.0.3"
  }
}
