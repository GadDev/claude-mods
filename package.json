{
  "name": "@gaddev/claude-mods",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "mods/*"
  ],
  "scripts": {
    "types:fetch": "node scripts/fetch-mod-types.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json",
    "test": "node --test tests/*.test.ts",
    "validate": "node scripts/validate.ts",
    "check:native": "claude plugin validate . && claude plugin validate ./mods/context-studio && claude plugin test ./mods/context-studio",
    "check": "npm run validate && npm run typecheck && npm test && npm run check:native"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "2.1.308",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
